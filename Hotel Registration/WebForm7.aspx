<%@ Page Title="" Language="C#" MasterPageFile="~/Site1.Master" 
    AutoEventWireup="true" 
    CodeBehind="WebForm7.aspx.cs" 
    Inherits="Hotel_Registration.WebForm7" %>


<asp:Content ID="Content1" ContentPlaceHolderID="head" runat="server">

<style>

body
{
    background:#f4f7fb;
    font-family:Arial, Helvetica, sans-serif;
}


.hotel-box
{
    width:90%;
    margin:40px auto;
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0px 5px 20px rgba(0,0,0,0.15);
    text-align:center;
}


.title
{
    font-size:32px;
    font-weight:bold;
    color:#0d6efd;
}


.subtitle
{
    font-size:18px;
    color:#555;
}


.grid
{
    width:70%;
    margin:25px auto;
    border-collapse:collapse;
}


.grid th
{
    background:#0d6efd;
    color:white;
    padding:12px;
    font-size:17px;
}


.grid td
{
    padding:10px;
    border:1px solid #ddd;
    text-align:center;
}


.grid tr:nth-child(even)
{
    background:#f8f9fa;
}


.grid tr:hover
{
    background:#d9ecff;
}


.grid input[type=text]
{
    width:90%;
    height:28px;
    border:1px solid #ccc;
    border-radius:5px;
    padding-left:5px;
}


.grid input[type=submit]
{
    background:#0d6efd;
    color:white;
    border:none;
    padding:6px 12px;
    border-radius:5px;
    cursor:pointer;
}


.grid input[type=submit]:hover
{
    background:#084298;
}


.register-btn
{
    margin-top:25px;
    width:300px;
    height:45px;
    background:#198754;
    color:white;
    border:none;
    border-radius:8px;
    font-size:18px;
    font-weight:bold;
    cursor:pointer;
}


.register-btn:hover
{
    background:#146c43;
    transform:scale(1.05);
    transition:0.3s;
}

</style>

</asp:Content>



<asp:Content ID="Content2" ContentPlaceHolderID="Maincontent" runat="server">


<div class="hotel-box">


<asp:Label 
    ID="Label1" 
    runat="server" 
    CssClass="title"
    Text="Hotel Registrations">
</asp:Label>


<br /><br />


<asp:Label 
    ID="Label2" 
    runat="server"
    CssClass="subtitle"
    Text="Below are the hotel registration details">
</asp:Label>


<br /><br />


<asp:GridView 
    ID="GridView1" 
    runat="server"
    CssClass="grid"
    AutoGenerateColumns="False"
    AutoGenerateDeleteButton="True"
    AutoGenerateEditButton="True"
    GridLines="None"
    CellPadding="5"
    OnSelectedIndexChanged="GridView1_SelectedIndexChanged"
    OnRowCancelingEdit="GridView1_RowCancelingEdit"
    OnRowDeleting="GridView1_RowDeleting"
    OnRowEditing="GridView1_RowEditing"
    OnRowUpdating="GridView1_RowUpdating">


<Columns>


<asp:TemplateField HeaderText="Username">

<EditItemTemplate>
<asp:TextBox 
    ID="TextBox1" 
    runat="server"
    Text='<%# Bind("username") %>'>
</asp:TextBox>
</EditItemTemplate>


<ItemTemplate>
<asp:Label 
    ID="Label1" 
    runat="server"
    Text='<%# Bind("username") %>'>
</asp:Label>
</ItemTemplate>

</asp:TemplateField>



<asp:TemplateField HeaderText="Room Type">


<EditItemTemplate>
<asp:TextBox 
    ID="TextBox2"
    runat="server"
    Text='<%# Bind("Roomtype") %>'>
</asp:TextBox>
</EditItemTemplate>


<ItemTemplate>
<asp:Label 
    ID="Label2"
    runat="server"
    Text='<%# Bind("Roomtype") %>'>
</asp:Label>
</ItemTemplate>


</asp:TemplateField>




<asp:TemplateField HeaderText="Amenities">


<EditItemTemplate>

<asp:TextBox 
    ID="TextBox3"
    runat="server"
    Text='<%# Bind("Amenities") %>'>
</asp:TextBox>

</EditItemTemplate>


<ItemTemplate>

<asp:Label 
    ID="Label3"
    runat="server"
    Text='<%# Bind("Amenities") %>'>
</asp:Label>

</ItemTemplate>


</asp:TemplateField>


</Columns>


</asp:GridView>



<br />


<asp:Button 
    ID="Button1"
    runat="server"
    CssClass="register-btn"
    Text="Hotel Registration"
    OnClick="Button1_Click" />


</div>


</asp:Content>
